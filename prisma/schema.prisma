// Bansal Jewellers — WhatsApp CRM schema.
// Phase 0 (foundation) + Phase 1 (CRM/contacts/tags/consent) models.
// Templates, Media, Campaigns, Automations and Gold/Silver Rates are
// added in their own phases so relations never dangle mid-build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── admin / auth ───────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("owner") // owner | agent — extend when multi-agent lands
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedConversations Conversation[] @relation("ConversationAssignee")
  assignedContacts      Contact[]      @relation("ContactAssignee")
  notes                 ContactNote[]
  enteredRateEntries    RateEntry[]

  @@map("admin_users")
}

// ───────────────────── whatsapp accounts (multi-number ready) ─────────────────────

model WhatsappAccount {
  id                 String   @id @default(cuid())
  label              String
  phoneNumberId      String   @unique @map("phone_number_id")
  wabaId             String?  @map("waba_id")
  displayPhoneNumber String?  @map("display_phone_number")
  isDefault          Boolean  @default(true) @map("is_default")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  conversations Conversation[]
  messages      Message[]
  consents      Consent[]

  @@map("whatsapp_accounts")
}

// ─────────────────────────────────── CRM ───────────────────────────────────

model Contact {
  id             String    @id @default(cuid())
  whatsappNumber String    @unique @map("whatsapp_number") // E.164 digits, no leading +
  name           String?
  email          String?
  birthday       DateTime? @db.Date
  anniversary    DateTime? @db.Date
  city           String?
  source         String? // e.g. website, walk_in, referral, website_gold_rate
  customerType   String?   @map("customer_type") // e.g. retail, wholesale, vip

  marketingOptIn      Boolean   @default(false) @map("marketing_opt_in")
  marketingOptInAt    DateTime? @map("marketing_opt_in_at")
  marketingOptOutAt   DateTime? @map("marketing_opt_out_at")
  optInSource         String?   @map("opt_in_source")

  firstInteractionAt DateTime? @map("first_interaction_at")
  lastInteractionAt  DateTime? @map("last_interaction_at")

  assignedAgentId String?    @map("assigned_agent_id")
  assignedAgent   AdminUser? @relation("ContactAssignee", fields: [assignedAgentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags          ContactTag[]
  notes         ContactNote[]
  consents      Consent[]
  conversations Conversation[]
  rateRequests  RateRequest[]

  @@index([marketingOptIn])
  @@index([source])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  id        String   @id @default(cuid())
  contactId String   @map("contact_id")
  tagId     String   @map("tag_id")
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String   @map("contact_id")
  authorId  String?  @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  AdminUser? @relation(fields: [authorId], references: [id])

  @@index([contactId])
  @@map("contact_notes")
}

model Consent {
  id                String   @id @default(cuid())
  contactId         String   @map("contact_id")
  whatsappAccountId String?  @map("whatsapp_account_id")
  purpose           String   @default("marketing") // marketing — room for other consent purposes later
  status            String // opted_in | opted_out
  source            String? // e.g. website_gold_rate, whatsapp_stop_keyword, manual, whatsapp_conversation
  eventAt           DateTime @default(now()) @map("event_at")
  rawPayload        Json?    @map("raw_payload")

  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount? @relation(fields: [whatsappAccountId], references: [id])

  @@index([contactId])
  @@map("consents")
}

// ───────────────────────── conversations & messages ─────────────────────────

model Conversation {
  id                String    @id @default(cuid())
  contactId         String    @map("contact_id")
  whatsappAccountId String    @map("whatsapp_account_id")
  status            String    @default("open") // open | pending | resolved
  assignedAgentId   String?   @map("assigned_agent_id")
  unreadCount       Int       @default(0) @map("unread_count")
  lastMessageAt     DateTime? @map("last_message_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  contact         Contact         @relation(fields: [contactId], references: [id])
  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id])
  assignedAgent   AdminUser?      @relation("ConversationAssignee", fields: [assignedAgentId], references: [id])
  messages        Message[]

  @@unique([contactId, whatsappAccountId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("conversations")
}

model Message {
  id                     String    @id @default(cuid())
  conversationId         String    @map("conversation_id")
  contactId              String    @map("contact_id") // denormalized for fast per-contact queries/timeline
  whatsappAccountId      String    @map("whatsapp_account_id")
  whatsappMessageId      String?   @unique @map("whatsapp_message_id") // Meta's wamid — idempotency key
  contextWhatsappMessageId String? @map("context_whatsapp_message_id") // wamid this message replies to, if any
  direction              String // inbound | outbound
  type                   String // text | image | video | audio | document | template | interactive
  textBody               String?   @map("text_body")
  mediaId                String?   @map("media_id") // Meta media object id — fetched on demand, never stored locally
  mediaMimeType          String?   @map("media_mime_type")
  mediaCaption           String?   @map("media_caption")
  mediaFilename          String?   @map("media_filename")
  templateName           String?   @map("template_name")
  status                 String    @default("sent") // queued | sent | delivered | read | failed
  errorMessage           String?   @map("error_message")
  isAiGenerated          Boolean   @default(false) @map("is_ai_generated")
  sentAt                 DateTime? @map("sent_at")
  deliveredAt            DateTime? @map("delivered_at")
  readAt                 DateTime? @map("read_at")
  failedAt               DateTime? @map("failed_at")
  rawPayload             Json?     @map("raw_payload")
  createdAt              DateTime  @default(now()) @map("created_at")

  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id])
  events          MessageEvent[]

  @@index([conversationId])
  @@index([contactId])
  @@map("messages")
}

model MessageEvent {
  id         String   @id @default(cuid())
  messageId  String   @map("message_id")
  eventType  String   @map("event_type") // sent | delivered | read | failed
  eventAt    DateTime @default(now()) @map("event_at")
  rawPayload Json?    @map("raw_payload")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, eventType])
  @@index([messageId])
  @@map("message_events")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique @map("event_id") // dedupe key (wamid or a payload hash)
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("webhook_events")
}

// ─────────────────────────────────── audit ───────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  contactId String?  @map("contact_id") // which customer's timeline this belongs to, if any
  action    String // contact_created | tag_added | tag_removed | note_added | consent_changed | message_inbound | message_outbound | ...
  entity    String? // the record this event is actually about, e.g. "message", "contact_tag"
  entityId  String?  @map("entity_id")
  meta      Json? // small structured details (e.g. { preview, tagName }) — never full message bodies twice over
  createdAt DateTime @default(now()) @map("created_at")

  @@index([contactId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ───────────────────────── gold & silver rates (Phase 2) ─────────────────────────

model RateType {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. GOLD_24K, GOLD_22K, GOLD_18K, SILVER — stable, never shown to customers
  name         String // e.g. "Gold 24K"
  metal        String // gold | silver | platinum — for filtering, not display
  purity       String? // e.g. "24K", "999" — null where not meaningful
  displayName  String   @map("display_name") // e.g. "24K Gold" — used in customer-facing messages
  unit         String // free text set by admin, e.g. "10g", "kg" — gold and silver are NOT assumed to share a unit
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entries RateEntry[]

  @@map("rate_types")
}

model RateEntry {
  id          String    @id @default(cuid())
  rateTypeId  String    @map("rate_type_id")
  value       Decimal   @db.Decimal(12, 2) // rupees — Decimal, never float, for currency precision
  rateDate    DateTime  @db.Date @map("rate_date") // the IST business calendar date this rate is FOR
  effectiveAt DateTime  @default(now()) @map("effective_at") // when it was actually entered
  source      String    @default("manual") // manual | api | manual_override — RateService is source-agnostic to callers
  enteredById String?   @map("entered_by_id")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  rateType  RateType   @relation(fields: [rateTypeId], references: [id])
  enteredBy AdminUser? @relation(fields: [enteredById], references: [id])

  // One entry per rate type per calendar day — re-entering "today's" rate
  // updates that day's row rather than creating a second one; yesterday's
  // row is a separate, untouched date and is never overwritten.
  @@unique([rateTypeId, rateDate])
  @@index([rateTypeId])
  @@map("rate_entries")
}

model RateRequest {
  id                String   @id @default(cuid())
  contactId         String   @map("contact_id")
  whatsappAccountId String?  @map("whatsapp_account_id")
  source            String // website | whatsapp_bot
  requestedType     String   @map("requested_type") // "all" | "gold" | "silver" | a RateType code
  rateSnapshot      Json     @map("rate_snapshot") // frozen values at request time — never re-derived from "current" later
  marketingOptIn    Boolean  @default(false) @map("marketing_opt_in")
  deliveryStatus    String   @default("pending") @map("delivery_status") // sent | failed | pending_configuration | rate_missing
  messageId         String?  @map("message_id") // Message.id if an outbound message row was created
  ipHash            String?  @map("ip_hash") // sha256 of the request IP — never the raw IP
  createdAt         DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([source])
  @@index([createdAt])
  @@map("rate_requests")
}
