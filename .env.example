# ─────────────────────────────────────────────────────────────
# Bansal Jewellers — environment configuration
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public origin of the site (used to build absolute links / webhook URL hints)
BASE_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# Admin CRM (WhatsApp inbox, contacts, campaigns, etc. at /admin)
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Render → New + → PostgreSQL → connection string)
DATABASE_URL=

# Long random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Bootstraps the first admin login on first run only. Never overwrites an
# existing admin user — safe to leave set after the first deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API  (https://developers.facebook.com/apps)
# Everything below is OPTIONAL. While it is blank the site still
# works — enquiry forms fall back to wa.me deep links and no
# outbound Cloud API calls are made.
# ─────────────────────────────────────────────────────────────

# Graph API version to call
WHATSAPP_GRAPH_VERSION=v21.0

# Permanent (system user) access token from the Meta app
WHATSAPP_TOKEN=

# The "Phone number ID" of your WhatsApp sender (NOT the phone number)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA id)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Any string you choose — you type the SAME value into the Meta
# webhook "Verify token" field when subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=bansal-jewellers-verify

# Meta App Secret — enables X-Hub-Signature-256 verification of
# incoming webhooks. Strongly recommended in production.
WHATSAPP_APP_SECRET=

# Where enquiry alerts are sent (the shop owner's number in
# international format without +, e.g. 918826481301). If blank,
# the number in data/brand.json (phoneRaw) is used.
WHATSAPP_NOTIFY_TO=

# Auto-reply to customers who message the WhatsApp number.
# Set to "false" to disable.
WHATSAPP_AUTO_REPLY=true
