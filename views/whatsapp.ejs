<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/whatsapp.css" />
</head>
<body>
  <div class="wa-demo-banner">
    Preview build with sample conversations — not connected to the real WhatsApp Business number.
    <a href="/">&larr; Back to <%= brand.name %></a>
  </div>

  <div class="wa-app">
    <aside class="wa-sidebar">
      <div class="wa-sidebar__header">
        <div class="wa-avatar wa-avatar--lg"><%= brand.initials %></div>
        <strong><%= brand.name %></strong>
      </div>
      <div class="wa-sidebar__search">
        <input id="wa-search-input" type="text" placeholder="Search or start new chat" autocomplete="off" />
      </div>
      <div class="wa-conversations" id="wa-conversations"></div>
    </aside>

    <section class="wa-chat">
      <div class="wa-empty" id="wa-empty">
        <div>
          <p style="font-size:16px;color:var(--wa-text-1);margin-bottom:6px;">WhatsApp inbox preview</p>
          <p>Select a conversation on the left to see sample messages.</p>
        </div>
      </div>

      <div class="wa-chat__header" id="wa-chat-header" hidden>
        <div class="wa-chat__who">
          <button class="wa-chat__back" id="wa-back-btn" aria-label="Back to chat list">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"/></svg>
          </button>
          <div class="wa-avatar" id="wa-chat-avatar"></div>
          <div>
            <div class="wa-chat__name" id="wa-chat-name"></div>
            <div class="wa-chat__status" id="wa-chat-status"></div>
          </div>
        </div>
        <div class="wa-chat__icons">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11z"/></svg>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/></svg>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
        </div>
      </div>

      <div class="wa-messages" id="wa-messages"></div>

      <form class="wa-composer" id="wa-composer" hidden>
        <div class="wa-composer__icons">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm-3 6.5A1.5 1.5 0 1 1 7.5 10 1.5 1.5 0 0 1 9 8.5zm7.5 1.5A1.5 1.5 0 1 1 15 8.5 1.5 1.5 0 0 1 16.5 10zM12 18c-2.5 0-4.6-1.4-5.7-3.5a.9.9 0 0 1 1.6-.8A5 5 0 0 0 12 16a5 5 0 0 0 4.1-2.3.9.9 0 1 1 1.6.8A6.9 6.9 0 0 1 12 18z"/></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 6.5v9a4.5 4.5 0 1 1-9 0v-11a3 3 0 1 1 6 0v10a1.5 1.5 0 1 1-3 0v-9H9v9a3 3 0 1 0 6 0v-10a4.5 4.5 0 1 0-9 0v11a6 6 0 1 0 12 0v-9z"/></svg>
        </div>
        <input id="wa-composer-input" type="text" placeholder="Type a message" autocomplete="off" />
        <button type="submit" class="wa-composer__send" aria-label="Send">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
        </button>
      </form>
    </section>
  </div>

  <script type="application/json" id="wa-dummy-data"><%- JSON.stringify(conversations) %></script>
  <script src="/js/whatsapp.js"></script>
</body>
</html>
