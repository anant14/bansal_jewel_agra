<div class="wafloat" id="wafloat">
  <div class="wafloat__panel" id="wafloat-panel">
    <p><%= whatsappQuick.heading %></p>
    <% whatsappQuick.pills.forEach(function (pill) { %>
      <a href="<%= waLink(pill.message) %>" target="_blank" rel="noopener"><%= pill.label %></a>
    <% }); %>
  </div>

  <button class="wafloat__btn" id="wafloat-btn" aria-label="Chat on WhatsApp" aria-expanded="false">
