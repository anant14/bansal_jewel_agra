<section class="rate-cta" id="rate-cta">
  <div class="container rate-cta__inner">
    <div class="rate-cta__text">
      <p class="rate-cta__eyebrow">Live Today</p>
      <h2 class="rate-cta__title">Get Today&rsquo;s Gold &amp; Silver Rate on WhatsApp</h2>
      <p class="rate-cta__sub">Enter your WhatsApp number and receive today&rsquo;s <%= brand.name %> gold &amp; silver rates.</p>
    </div>
    <button type="button" class="btn btn--gold rate-cta__btn" id="open-rate-request">Get Today&rsquo;s Rate</button>
  </div>
</section>
