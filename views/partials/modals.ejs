<!-- Quick View modal -->
<div class="modal" id="quickview-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal__box" style="position:relative">
    <button class="modal__close" data-modal-close aria-label="Close">&times;</button>
    <div class="qv" id="quickview-content"><!-- filled by JS --></div>
  </div>
</div>

<!-- Enquiry modal -->
<div class="modal" id="enquiry-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal__box" style="position:relative">
    <button class="modal__close" data-modal-close aria-label="Close">&times;</button>

    <form class="form" id="enquiry-form" novalidate>
      <h3 class="form__title" id="enquiry-title">Send an Enquiry</h3>
      <p class="form__note">
        Share your details and our team will contact you personally. You can also continue straight to WhatsApp.
      </p>

      <div class="form__product" id="enquiry-product" hidden></div>

      <input type="hidden" name="type" id="enquiry-type" value="general" />
      <input type="hidden" name="productSku" id="enquiry-sku" />
      <input type="hidden" name="productName" id="enquiry-pname" />
      <input type="hidden" name="fallbackMessage" id="enquiry-fallback" />

      <!-- honeypot -->
      <div class="form__hp" aria-hidden="true">
        <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="form__row two">
        <div class="field">
          <label for="f-name">Your Name</label>
          <input type="text" id="f-name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="f-phone">Phone / WhatsApp</label>
          <input type="tel" id="f-phone" name="phone" required autocomplete="tel" />
        </div>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="f-email">Email <span style="text-transform:none">(optional)</span></label>
          <input type="email" id="f-email" name="email" autocomplete="email" />
        </div>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="f-message">Message</label>
          <textarea id="f-message" name="message" placeholder="Tell us what you are looking for…"></textarea>
        </div>
      </div>

      <p class="form__msg" id="enquiry-msg" role="status"></p>

      <button type="submit" class="btn btn--gold btn--block" id="enquiry-submit">Send Enquiry</button>

      <div class="form__success" id="enquiry-success" hidden>
        <h3>Thank you 🙏</h3>
        <p class="form__note" id="enquiry-success-text">
          Our team will contact you shortly.
        </p>
        <a class="btn btn--ghost btn--block" id="enquiry-wa-link" href="#" target="_blank" rel="noopener">
          Continue on WhatsApp
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Gold & Silver Rate request modal -->
<div class="modal" id="rate-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal__box" style="position:relative">
    <button class="modal__close" data-modal-close aria-label="Close">&times;</button>

    <form class="form" id="rate-form" novalidate>
      <h3 class="form__title">Get Today&rsquo;s Gold &amp; Silver Rate</h3>
      <p class="form__note">
        Enter your WhatsApp number and we&rsquo;ll send today&rsquo;s gold &amp; silver rates straight to you.
      </p>

      <!-- honeypot -->
      <div class="form__hp" aria-hidden="true">
        <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="r-name">Your Name <span style="text-transform:none">(optional)</span></label>
          <input type="text" id="r-name" name="name" autocomplete="name" />
        </div>
      </div>
      <div class="form__row">
        <div class="field">
          <label for="r-phone">WhatsApp Number</label>
          <input type="tel" id="r-phone" name="whatsappNumber" required autocomplete="tel" placeholder="e.g. 98765 43210" />
        </div>
      </div>

      <p class="form__consent">
        By submitting, you agree that <%= typeof brand !== 'undefined' ? brand.name : 'we' %> may send today&rsquo;s
        requested Gold &amp; Silver rate to this WhatsApp number.
      </p>

      <label class="form__checkbox">
        <input type="checkbox" id="r-marketing" name="marketingOptIn" />
        <span>Also send me occasional jewellery updates, offers and rate updates on WhatsApp.</span>
      </label>

      <p class="form__msg" id="rate-msg" role="status"></p>

      <button type="submit" class="btn btn--gold btn--block" id="rate-submit">Send Me Today&rsquo;s Rate</button>

      <div class="form__success" id="rate-success" hidden>
        <h3 id="rate-success-title">Thank you 🙏</h3>
        <p class="form__note" id="rate-success-text"></p>
      </div>
    </form>
  </div>
</div>
