<section class="section section--alt" id="visit">
  <div class="container">
    <div class="section-head reveal">
      <%- include('_title', { eyebrow: showroom.eyebrow, heading: showroom.heading, goldWord: showroom.goldWord }) %>
    </div>

    <div class="showroom__photos reveal">
      <% showroom.photos.forEach(function (photo) { %>
        <figure class="<%= photo.wide ? 'wide' : '' %>">
          <img src="<%= photo.src %>" alt="<%= photo.alt %>" loading="lazy" />
        </figure>
      <% }); %>
    </div>

    <div class="showroom__grid">
      <div class="reveal">
        <p class="lead">
          Walk into two centuries of karigari. Our master jewellers will show you loose diamonds,
          run a live karat-meter purity test, and talk you through every design — gold, polki or solitaire.
        </p>
        <div style="margin-top:26px">
          <a class="btn btn--ghost" href="<%= brand.googleMapsUrl %>" target="_blank" rel="noopener">Open in Google Maps</a>
        </div>
      </div>

      <div class="info-card reveal">
        <p class="info-card__label"><%= showroom.cardLabel %></p>

        <div class="info-row">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 1 1 18 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span><%= brand.address %></span>
        </div>

        <div class="info-row">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 12a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c1 .3 1.9.5 2.9.6a2 2 0 0 1 1.7 2Z" />
          </svg>
          <a href="tel:<%= brand.phoneTel %>"><%= brand.phoneDisplay %></a>
        </div>

        <div class="info-row">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
          <span><%= brand.hours %></span>
        </div>

        <div class="info-card__actions">
          <a
            class="btn btn--gold btn--block"
            href="<%= waLink(showroom.bookCta.message) %>"
            target="_blank"
            rel="noopener"
            data-enquiry
            data-type="appointment"
            data-title="<%= showroom.bookCta.label %>"
            data-message="<%= showroom.bookCta.message %>"
          ><%= showroom.bookCta.label %></a>
        </div>
      </div>
    </div>
  </div>
</section>
