<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0D0C0A" />
<title><%= page.title %></title>
<% const _desc = (typeof brand !== 'undefined' && brand.metaDescription) ? brand.metaDescription : 'Bansal Jewellers, Agra — a 200-year-old, ninth-generation jewellery house.'; %>
<meta name="description" content="<%= _desc %>" />
<meta property="og:type" content="website" />
<meta property="og:title" content="<%= page.title %>" />
<meta property="og:description" content="<%= _desc %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500;700&display=swap"
  rel="stylesheet"
/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="/css/styles.css" />
