<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0D0C0A" />
<title><%= page.title %></title>
<% const _desc = (typeof brand !== 'undefined' && brand.metaDescription) ? brand.metaDescription : 'Bansal Jewellers, Agra — a 185-year-old, ninth-generation jewellery house.'; %>
<meta name="description" content="<%= _desc %>" />
<% const _site = (typeof brand !== 'undefined' && brand.siteUrl) ? brand.siteUrl : ''; %>
<meta property="og:type" content="website" />
<meta property="og:site_name" content="<%= (typeof brand !== 'undefined' && brand.name) || 'Bansal Jewellers' %>" />
<meta property="og:title" content="<%= page.title %>" />
<meta property="og:description" content="<%= _desc %>" />
<meta property="og:image" content="<%= _site %>/logo-512.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500;700&display=swap"
  rel="stylesheet"
/>
<%# Square PNG/ICO icons made from the brand logo — Google Search shows the favicon (>= 48px, square) next to the site name. %>
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
